DATABASE_URL="file:./prisma/dev.db"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET=""
# Only needed for npm run admin:create; never commit actual values.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Trust forwarded IPs only behind a proxy that overwrites these headers.
TRUST_PROXY="false"
# Optional: absolute persistent media directory (default .data/media)
# MEDIA_ROOT="/absolute/path/to/media"
# ADMIN_NAME="Site administrator"
