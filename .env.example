DATABASE_URL="file:./prisma/dev.db"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET=""
# Only needed for npm run admin:create; never commit actual values.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Trust forwarded IPs only behind a proxy that overwrites these headers.
TRUST_PROXY="false"
# Optional: absolute persistent media directory (default .data/media)
# MEDIA_ROOT="/absolute/path/to/media"
# ADMIN_NAME="Site administrator"

# Free hosted demo: see docs/FREE_DEPLOYMENT.md. Use a separate ignored env file.
# DATABASE_URL="postgresql://...transaction-pooler:6543/postgres?pgbouncer=true&sslmode=verify-full"
# DIRECT_URL="postgresql://...session-pooler:5432/postgres?sslmode=verify-full"
MEDIA_STORAGE="local"
# MEDIA_STORAGE="supabase"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="property-media"
